# Copy to foundry/.env and fill in. (foundry/.env is gitignored.)

# Path to your Foundry VTT install root (the directory containing Data/, App/,
# Config/...). Accepts a Windows path (auto-converted via wslpath under WSL) or
# a native Unix path. Used by dev-install.sh.
FOUNDRY_PATH=C:\Users\jared\FoundryVTT-WindowsPortable-14.359

# FoundryVTT package-registry API token. Optional — release.sh only publishes to
# the registry when this is set; otherwise it stops after the GitHub release.
FOUNDRY_RELEASE_TOKEN=
